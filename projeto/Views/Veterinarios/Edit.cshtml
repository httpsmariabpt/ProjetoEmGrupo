@model projeto.Models.Veterinario

@{
    ViewData["Title"] = "Edit";
}

<body class="bgFundo">


    <h1 class="text-white">Editar Cliente</h1>
    <hr />
    <div class="row">
        <div class="col-md-4 text-white">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="VeterinarioId" />
                <div class="form-group">
                    <label asp-for="Nome" class="control-label"></label>
                    <input asp-for="Nome" class="form-control" />
                    <span asp-validation-for="Nome" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CRMV" class="control-label"></label>
                    <input asp-for="CRMV" class="form-control" />
                    <span asp-validation-for="CRMV" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Celular" class="control-label"></label>
                    <input asp-for="Celular" class="form-control" />
                    <span asp-validation-for="Celular" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="EspecialidadeId" class="control-label">Especialidade</label>
                    <select asp-for="EspecialidadeId" class="form-control" asp-items="ViewBag.EspecialidadeId"></select>
                    <span asp-validation-for="EspecialidadeId" class="text-danger"></span>
                </div>
                <div class="form-group py-2">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-2">
        <a asp-action="Index" class="text-white text-decoration-none bg-secondary py-2 px-2 rounded-2">
            Voltar para Veterinario
        </a>
    </div>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>