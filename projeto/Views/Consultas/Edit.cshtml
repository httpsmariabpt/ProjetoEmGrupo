@model projeto.Models.Consulta

@{
    ViewData["Title"] = "Edit";
}

<body class="bgFundo">


    <h1 class="text-white">Editar Consulta</h1>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ClienteId" />
                <div class="form-group">
                    <label asp-for="Data" class="control-label text-white">Data</label>
                    <select asp-for="Data" class="form-control" asp-items="ViewBag.ConsultaId">
                        <option value="">Data</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="VeterinarioId" class="control-label text-white">Médico</label>
                    <select asp-for="VeterinarioId" class="form-control" asp-items="ViewBag.VeterinarioId">
                        <option value="">Selecione um Veterinário</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="ClienteId" class="control-label text-white">Médico</label>
                    <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId">
                        <option value="">Selecione um Veterinário</option>
                    </select>
                </div>
                <div class="form-group py-2">
                    <input type="submit" value="Salvar" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div class="mt-2">
        <a asp-action="Index" class="text-white text-decoration-none bg-secondary py-2 px-2 rounded-2">
            Voltar para Consulta
        </a>
    </div>
    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>