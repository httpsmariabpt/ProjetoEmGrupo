@model projeto.Models.Consulta

@{
    ViewData["Title"] = "Create";
}

<body class="bgFundo">


<h1 class="text-white">Criar Consulta</h1>

<hr />
<div class="row">
    <div class="col-md-4 text-white">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger text-white"></div>
            <div class="form-group">
                <div class="form-group">
                    <label asp-for="Data" class="control-label text-white">Data da consulta</label>
                    <input asp-for="Data" class="form-control" />
                    <span asp-validation-for="Data" class="text-danger"></span>
                </div>
                <label asp-for="ClienteId" class="control-label text-white">Cliente</label>
                    <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId">
                    <option value="">Selecione um cliente</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="VeterinarioId" class="control-label text-white">Médico</label>
                <select asp-for="VeterinarioId" class="form-control" asp-items="ViewBag.VeterinarioId">
                    <option value="">Selecione um Veterinário</option>
                </select>
            </div> 
            <div class=" form-goup py-2">
                <input type="submit" value="Adicionar consulta" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-2">
    <a asp-action="Index" class="text-white text-decoration-none bg-secondary py-2 px-2 rounded-2">Voltar para agenda</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
</body>