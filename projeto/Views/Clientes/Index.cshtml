@model IEnumerable<projeto.Models.Cliente>

@{
    ViewData["Title"] = "Index";
}
<body class="bgFundo">

<div class="cantainer text-white">
    <h1 class="text-center display-5 text-white">Cadastro de <span class="fw-bold text-white">Clientes</span></h1>

    <p>
        <a asp-action="Create" class="btn btn-outline-dark btn-lg w-25 text-white">Adicionar Novo Cliente.</a>
    </p>
    <table class="table table-bordered table-bordered text-white">
            <thead class="thead-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CPF)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Celular)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.DataNasc)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Endereco)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Email)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Animal)
                </th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.CPF)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Celular)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.DataNasc)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Endereco)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Email)
                    </td>
                    <td>
                        @Html.DisplayFor(modelItem => item.Animal.Nome)
                    </td>
                    <td class="taxt-center m-4">
                        <a asp-action="Edit" asp-route-id="@item.ClienteId"
                           class="btn btn-sm btn-warning me-2 d-inline-flex align-items-center">
                            Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.ClienteId"
                           class="btn btn-sm btn-danger d-inline-flex align-items-center ">
                            Deletar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</body>