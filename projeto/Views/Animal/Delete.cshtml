@model projeto.Models.Animal

@{
    ViewData["Title"] = "Delete";
}

<body class="bgFundo">


    <div class="container mt-5">
        <div class="card bg-dark text-white shadow-lg rounded-4">
            <div class="card-body p-5 text-center">
                <h2 class="mb-3 text-danger fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Deletar Cliente
                </h2>
                <p class="lead mb-4">Tem certeza que deseja excluir esse cliente?</p>

                <div class="border-top border-bottom py-3 my-4 text-start">
                    <dl class="row">
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Nome)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Nome)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Sexo)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Sexo)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Especie)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Especie)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Raca)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Raca)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Idade)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Idade)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Peso)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Peso)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Observacao)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Observacao)
                        </dd>
                        <dt class="col-sm-2">
                            @Html.DisplayNameFor(model => model.Ecastrado)
                        </dt>
                        <dd class="col-sm-10">
                            @Html.DisplayFor(model => model.Ecastrado)
                        </dd>
                    </dl>
                </div>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="AnimalId" />

                    <button type="submit" class="btn btn-danger btn-lg px-4 me-3">
                        Confirmar Exclusão
                    </button>

                    <a asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                        Voltar para Consultas
                    </a>
                </form>
            </div>
        </div>
    </div>

</body>