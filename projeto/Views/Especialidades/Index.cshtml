@model IEnumerable<projeto.Models.Especialidade>

@{
    ViewData["Title"] = "Index";
}

<body class="bgFundo">

    
<div class="cantainer text-white">
    <h1 class="text-center display-5 text-white">Cadastro de <span class="fw-bold text-white">Especialidades</span></h1>
    <p>
        <a asp-action="Create" class="btn btn-outline-dark btn-lg w-25 text-white">Adicionar Nova Especialidade.</a>
    </p>
        <table class="table table-bordered table-bordered text-white">

            <thead class="thead-light">
                <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Nome)
                </th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.Nome)
                    </td>
                    <td class="taxt-center my-4 ">
                        <a asp-action="Edit" asp-route-id="@item.EspecialidadeId"
                           class="btn btn-sm btn-warning d-inline-flex align-items-center">
                            Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.EspecialidadeId"
                           class="btn btn-sm btn-danger d-inline-flex align-items-center">
                            Deletar
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</body>